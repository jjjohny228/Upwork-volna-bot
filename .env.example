BOT_TOKEN=123456:ABC-DEF...
ADMIN_TELEGRAM_ID=123456789
DATABASE_URL=postgresql+asyncpg://upwork:upwork@db:5432/upwork
OPENAI_API_KEY=sk-...
POLL_INTERVAL_SECONDS=180

# Vollna sender + IMAP host are global (same for every user).
VOLLNA_SENDER=info@vollna.com
GMAIL_IMAP_HOST=imap.gmail.com

# DEPRECATED — now per-user, configured inside the bot (⚙️ Settings), not here.
# Migration 0009 reads these ONCE to seed the admin's first mailbox + rate/signature.
# Leave blank to configure everything in-bot.
PROPOSAL_SIGNATURE_NAME=
HOURLY_RATE=0
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_MAILBOX=INBOX

